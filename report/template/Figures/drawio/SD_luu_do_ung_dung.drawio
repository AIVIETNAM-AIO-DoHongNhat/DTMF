<mxfile host="drawio"><diagram name="SD_luu_do_ung_dung" id="SD_luu_do_ung_dung"><mxGraphModel dx="800" dy="600" grid="1" gridSize="5" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Bắt đầu" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;fontFamily=Times New Roman;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="290" y="0" width="100" height="34" as="geometry"/></mxCell><mxCell id="d1" value="Nguồn tín hiệu?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;fontFamily=Times New Roman;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="55" width="180" height="60" as="geometry"/></mxCell><mxCell id="c4" value="Nhập chuỗi phím hoặc bấm bàn phím&lt;br&gt;(mỗi phím phát ngay âm tương ứng)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;fontFamily=Times New Roman;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="140" width="300" height="50" as="geometry"/></mxCell><mxCell id="c5" value="Bước 1. Nhấn &lt;i&gt;Tạo tín hiệu&lt;/i&gt;:&lt;br&gt;dtmf_generate → &lt;i&gt;x&lt;/i&gt;[&lt;i&gt;n&lt;/i&gt;]&lt;br&gt;(hoặc &lt;i&gt;Mở tệp âm thanh&lt;/i&gt;: dtmf_readaudio)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;fontFamily=Times New Roman;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="215" width="300" height="50" as="geometry"/></mxCell><mxCell id="c5b" value="Bước 2. Chọn nhiễu, SNR, nhấn &lt;i&gt;Cộng nhiễu&lt;/i&gt;:&lt;br&gt;dtmf_addnoise → &lt;i&gt;y&lt;/i&gt;[&lt;i&gt;n&lt;/i&gt;]" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;fontFamily=Times New Roman;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="290" width="300" height="50" as="geometry"/></mxCell><mxCell id="c6" value="Bước 3. Chọn bộ giải mã, nhấn &lt;i&gt;Giải mã&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;fontFamily=Times New Roman;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="365" width="300" height="40" as="geometry"/></mxCell><mxCell id="c7" value="dtmf_run: &lt;i&gt;y&lt;/i&gt; − mean(&lt;i&gt;y&lt;/i&gt;) → bộ giải mã đã chọn" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;fontFamily=Times New Roman;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="430" width="300" height="40" as="geometry"/></mxCell><mxCell id="c8" value="Phát sinh lỗi?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;fontFamily=Times New Roman;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="495" width="160" height="60" as="geometry"/></mxCell><mxCell id="c9" value="ui_refresh: dạng sóng và phổ của &lt;i&gt;x&lt;/i&gt;[&lt;i&gt;n&lt;/i&gt;], &lt;i&gt;y&lt;/i&gt;[&lt;i&gt;n&lt;/i&gt;];&lt;br&gt;năng lượng 8 bin, khung quyết định" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;fontFamily=Times New Roman;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="580" width="300" height="50" as="geometry"/></mxCell><mxCell id="c10" value="Ghi thông báo&lt;br&gt;vào nhật ký" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;fontFamily=Times New Roman;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="500" width="120" height="50" as="geometry"/></mxCell><mxCell id="c11" value="Kết thúc lượt" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;fontFamily=Times New Roman;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="660" width="120" height="34" as="geometry"/></mxCell><mxCell id="d2" value="Cách thu?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;fontFamily=Times New Roman;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="460" y="140" width="160" height="60" as="geometry"/></mxCell><mxCell id="m1" value="Nhấn &lt;i&gt;Ghi âm rồi giải mã&lt;/i&gt;: thu &lt;i&gt;y&lt;/i&gt;[&lt;i&gt;n&lt;/i&gt;]&lt;br&gt;tới khi nhấn Dừng (tối đa 20 s)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;fontFamily=Times New Roman;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="240" width="210" height="55" as="geometry"/></mxCell><mxCell id="m2" value="Nhấn &lt;i&gt;Giải mã trực tiếp&lt;/i&gt;. Mỗi 50 ms:&lt;br&gt;dtmf_listen(đoạn mới) → hiện phím mới;&lt;br&gt;mỗi 1 s: vẽ lại các đồ thị" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;fontFamily=Times New Roman;fontColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="570" y="240" width="260" height="70" as="geometry"/></mxCell><mxCell id="d3" value="Nhấn Dừng?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;fontFamily=Times New Roman;fontColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="630" y="340" width="140" height="56" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1;endArrow=block;endFill=1;endSize=6;fontSize=13;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;" edge="1" parent="1" source="c3" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="Tổng hợp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1;endArrow=block;endFill=1;endSize=6;fontSize=13;labelBackgroundColor=#F